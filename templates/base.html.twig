<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <meta >
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        {# lien boootstrap #}
        <link rel="stylesheet" href={{asset("css/style.css")}}>
        {# lien fichier style  #}
        
        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>

    {# header contenant la barre de navigation extends sur toute les pages #}
    <header>
        <nav class="navbar fs-6 border-2 border-bottom">
            {# <div class="logo text-center">LOGO</div> #}
            <a href="{{ path('all_recipes') }}" class="btn border">LOGO</a>

            <form action="{{ path('all_recipes') }}">
                <input name="search" type="search" placeholder="Recherche" class="searchbar rounded border">
            </form>

            <div class="div_user text-center d-flex justify-content-end">
                <p style="margin: auto;">Nom utilisateur</p>
                <div class="cadre_user rounded d-flex align-items-center justify-content-center">
                    <a href=""><img src="image\person-fill.svg" class="i_user" alt=""></a>
                </div>
            </div>
        </nav>
    </header>

    <body>
        {% block body %}{% endblock %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    </body>
</html>
