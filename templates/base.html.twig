<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        
        
        <title>{% block title %}Bienvenu sur Infuse{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        {# lien boootstrap #}
        <link rel="stylesheet" href={{asset("css/style.css")}}>
        {# lien fichier style  #}
        
        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}


    </head>

    {# header contenant la barre de navigation extends sur toutes les pages #}
    <header>

        <style>

            body{
                background-color: rgb(202, 19, 99);
            }

            .logo{
                width: 90px;
            }

            h1{
                text-align: center;
            }

            main{
                width: 70%;
                margin: auto;
                background-color: white;
                padding-inline: 70px;
                padding-top: 20px;
                padding-bottom: 50px;
                margin-top: 20px;
            }

        </style>

        <nav class="navbar border-2 border-bottom d-flex justify-content-between bg-white">
            <div>
                <a href="{{ path('all_recipes') }}" class="">
                    <img src="{{ asset('uploads/Infuse_logo.png') }}" class="logo" alt="logo">
                </a>
            </div>


            <div class="">
                <form action="{{ path('all_recipes') }}" class="">
                    <input name="search" type="search" placeholder="Recherche" class="searchbar rounded border">
                </form>
            </div>


            <div class="">

                {% if app.user %}
                    
                    <a href="{{ path('new_recipe') }}" class=" m-1 link-underline-opacity-0 link-underline">Créer recette</a>
                    
                    {{app.user.username}}
                    
                    <a href="{{ path('parameters',{'id': app.user.id}) }}" class="m-2">
                        <img class="border rounded" src="{{ asset('uploads/person-fill.svg') }}" class="" alt="" style="width: 50px">
                    </a>

                    <div class="cadre_user rounded d-flex align-items-center justify-content-center">
                        <a href=""></a>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="link-underline-opacity-0 link-underline m-2">Connexion</a>
                    <a href="{{ path('user_new_cla') }}" class="link-underline-opacity-0 link-underline m-2">Créer un compte</a>
                {% endif %}

            </div>
        </nav>
    </header>

    <body>
        {% block body %}
        {% endblock %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    </body>
</html>
