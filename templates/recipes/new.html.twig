{% extends 'base.html.twig' %}

{% block title %}Hello RecipesController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }

    .step {
        display: none;
    }
    #step1{
        display: block;
    }
    .step:target {
        display: block;
    }

</style>

<div>
    <form action="" method="post" id="form" enctype="multipart/form-data">
        <label for="title">Nom de la recette</label>
        <input type="text" id="title" name="_title" required>
        
        <label for="image">Ajouter une image</label>
        <input type="file" name="image_" id="image_" accept="image/png, image/jpeg">

        <div>
            {% for categorie in categories %}
            <input type="checkbox" name="id_categorie[]" id="{{ categorie.id }}" value="{{categorie.id}}">
            <label for="{{categorie.name}}">{{categorie.name}}</label>
            <br>
            {% endfor %}
        </div>


        <label for="introduction">écrire une introduction</label>
        <input type="text" id="introduction" name="_introduction">

        <label for="portions">Préciser le nombre de personnes ou de parts du plat</label>
        <input type="number" id="portions" name="_portions" min="1" max="100" required>

        {# <div id="step1" class="step">
            <label for="steps">Rédiger les étapes à suivre pour la préparation</label>
            <input type="text" name="_steps">
            <a href="#step2">Suivant</a>
        </div> #}

        {% for i in 0..19 %}  
        
        <div id="step{{i}}" class="step">
            {% if i == 1 %}
            <label for="">Rédiger les étapes à suivre pour la préparation</label>
            {% endif %}

            <label for="">Etape {{i}}</label>
            <input type="text" id="_step{{i}}" name="_steps[]">

            {% if i != 1 %}
            <a href="#step{{i - 1}}">Précédent</a>
            {% endif %}

            {% if i != 21 %}
            <a href="#step{{i + 1}}">Ajouter une étape</a>
            {% endif %}
        </div>

        {% endfor %}

        <input type="hidden" name="_token" value="{{ csrf_token('new') }}">

        <button type="submit">Enregistrer</button>
        
    </form>
</div>

<div class="example-wrapper">
    <h1>Hello! ✅</h1>

    This friendly message is coming from:
    <ul>
        <li>Your controller at <code><a href="{{ 'C:/Users/steev/Projet symfony/site_rectte/src/Controller/RecipesController.php'|file_link(0) }}">src/Controller/RecipesController.php</a></code></li>
        <li>Your template at <code><a href="{{ 'C:/Users/steev/Projet symfony/site_rectte/templates/recipes/index.html.twig'|file_link(0) }}">templates/recipes/index.html.twig</a></code></li>
    </ul>
</div>
{% endblock %}
