{% extends 'base.html.twig' %}

{% block title %}Éditeur de recettes{% endblock %}

{% block body %}
<h1>Choisir les champs à modifier de la recette</h1>
<div>
    <form action="" method="post" enctype="multipart/form-data">
        <label for="title">Titre</label>
        <input type="text" id="title" name="_title" value="{{recipe.title}}">

        <label for="image">Remplacer l'image</label>
        <input type="file" name="image_" id="image_" accept="image/png, image/jpeg">

        <label for="introduction">Introduction</label>
        <input type="text" id="introduction" name="_introduction" value="{{recipe.introduction}}">

        <label for="portions">Portions</label>
        <input type="number" id="portions" name="_portions" value="{{recipe.portions}}" min="1" max="100">
        
        <input type="hidden" name="_token" value="{{ csrf_token('edit') }}">

        {% for ingr in recipe.ingredients %}
        <div class="mt-3 mb-3">
            <input type="text" name="_ingres[]" value="{{ingr.name}}">

            <label for="quantite">Quantité</label>
            <input type="number" name="_quantites[]" min="1" value="{{ingr.dose}}">

            <label for="">Unité :</label>
            {% if ingr.unit == 'nb' %}
            <select name="_units[]">
                <option selected="selected" value="nb">nombres</option>
                <option value="cl">centilitres</option>
                <option value="g">grammes</option>
            </select>
            {% endif %}

            {% if ingr.unit == 'cl' %}
            <select name="_units[]">
                <option value="nb">nombres</option>
                <option selected="selected" value="cl">centilitres</option>
                <option value="g">grammes</option>
            </select>
            {% endif %}

            {% if ingr.unit == 'g' %}
            <select name="_units[]">
                <option value="nb">nombres</option>
                <option value="cl">centilitres</option>
                <option selected="selected" value="g">grammes</option>
            </select>
            {% endif %}

        </div>
        {% endfor %}

        {% for step in steps %}
        <div class="mt-3 mb-3">
            <label for="">étape {{step.rank}}</label>
            <input type="text" name="_steps[]" value="{{step.content}}">    
        </div>
        {% endfor %}
        <button type="submit">Enregistrer les modifications</button>
    </form>
</div>
{% endblock %}
