    {# <div>
        {% for row in recipe.ingredients %}
        <div class="border">
            <p>{{row.name}}</p>
            <br>
            <div class="dose" id="dose">{{row.dose}}</div>{% if row.unit != 'nb' %}: {{row.unit}}{% endif %}
        </div>
        {% endfor %}
    </div> #}
    
    {# <button id="incrementButton">Increment</button>
    <button id="decrementButton">Decrement</button> #}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Sélectionnez l'élément HTML contenant les portions
            const portionsElement = document.getElementById('portions');
    
            // Sélectionnez tous les éléments HTML contenant les doses
            const doseElements = document.querySelectorAll('.dose');
    
            // Sélectionnez les boutons
            const incrementButton = document.getElementById('incrementButton');
            const decrementButton = document.getElementById('decrementButton');
    
            // Récupérez la valeur des portions et convertissez-la en nombre
            let portions = parseInt(portionsElement.textContent, 10);
    
            // Initialisez un tableau pour stocker les valeurs incr pour chaque dose
            const incrValues = [];
    
            // Calculez les valeurs incr pour chaque dose
            doseElements.forEach(doseElement => {
                const og = parseInt(doseElement.textContent, 10);
                const incr = og / portions;
                incrValues.push(incr);
            });
    
            // Fonction pour mettre à jour les doses
            function updateDoses(increment) {
                doseElements.forEach((doseElement, index) => {
                    
                    // Récupérez la valeur actuelle de la dose et convertissez-la en nombre
                    let currentDose = parseInt(doseElement.textContent, 10);
    
                    // Incrémentez ou décrémentez la dose par la valeur incr correspondante
                    currentDose += increment ? incrValues[index] : -incrValues[index];
    
                    // Mettez à jour le contenu de l'élément HTML avec la nouvelle dose
                    doseElement.textContent = currentDose;
                });
            }
    
            // Fonction pour mettre à jour les portions
            function updatePortions(increment) {
                portions += increment ? 1 : -1;
                portionsElement.textContent = portions;
            }
    
            // Ajoutez un gestionnaire d'événement au bouton d'incrémentation
            incrementButton.addEventListener('click', function() {
                updatePortions(true);
                updateDoses(true);
            });
    
            // Ajoutez un gestionnaire d'événement au bouton de décrémentation
            decrementButton.addEventListener('click', function() {
                if (portions > 1) {
                    updatePortions(false);
                    updateDoses(false);
                }
            });
        });
    </script>
    

    <div>
         <a href="{{ path('commentaire_new',{ 'id': recipe.id}) }}" class="link-underline link-underline-opacity-0">Ajouter commentaire</a>
    </div>
    <a href="{{ path('all_recipes') }}" class="link-underline link-underline-opacity-0">Retour</a>

    {% if app.user and app.user.id == recipe.UserId.id %}
        
    <form action="{{ path('recipe_delete',{ 'id': recipe.id}) }}" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_rec') }}">
        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette recette ?');">Supprimer la recette</button>
    </form>

    {% endif %}
</main>
