{% extends 'base.html.twig' %}

{% block title %}{{ recipe.title }}{% endblock %}

{% block body %}
    <h1>Recette : {{ recipe.title }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ recipe.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ recipe.title }}</td>
            </tr>
            <tr>
                <form action="{{ path('endorsement_new',{ 'id': recipe.id}) }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('new_endors') }}">
                    {% if endors == null %}
                    <button type="submit" name="vote" value="{{true}}">Upvote</button>
                    {% elseif endors.vote == true %}
                    <button type="submit" name="vote" value="{{true}}">Déja Upvoter</button>
                    {% else %}
                    <button type="submit" name="vote" value="{{true}}">Upvote</button>
                    {% endif %}
                </form>
                <form action="{{ path('endorsement_new',{ 'id': recipe.id}) }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('new_endors') }}">
                    {% if endors == null %}
                    <button type="submit" name="vote" value="{{false}}">Downvote</button>
                    {% elseif endors.vote == false %}
                    <button type="submit" name="vote" value="{{false}}">Déja Downvoter</button>
                    {% else %}
                    <button type="submit" name="vote" value="{{false}}">Downvote</button>
                    {% endif %}
                </form>
            </tr>
            <tr>
                <th>
                    image
                </th>
                <td>
                    <img src="{{ asset('uploads/' ~ recipe.image) }}" alt="">
                </td>
            </tr>
            <tr>
                <th>Contenu</th>
                <td>
                    {{ recipe.introduction }}
                </td>
            </tr>
            <tr>
                <th>Préparation</th>
                <td>
                    {% for row in steps %}
                    <h4>
                        étapes {{loop.index}}
                    </h4>
                    <p>
                        {{steps[loop.index0].content}}
                    </p>
                    {% endfor %}
                </td>
            </tr>
        </tbody>
    </table>

    <div>    
        {% if fav is not null %}
        <form action="{{ path('favorites_delete', {'id': recipe.id, 'fav': fav.id }) }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('del_fav') }}"> 
            <button type="submit" class="btn border">Déjà en favoris</button>
        </form>
        {% else %}
        <form action="{{ path('favorites_new', {'id' : recipe.id}) }}" method="post"> 
            <input type="hidden" name="_token" value="{{ csrf_token('new_fav') }}">
            <button type="submit" class="btn border">Ajouter en favoris</button>
        </form>
        {% endif %}
    </div>

    <div>
        {%for commentaire in commentaires %}
         <table class="table">
        <tbody>
            <tr>
                <td>{{ commentaire.UserId.username}}</td>
                
                <td>
                    {% if app.user and app.user.id == commentaire.UserId.id %}
                    <a href="{{ path('commentaire_edit', {'id' : recipe.id , 'com': commentaire.id}) }}">editer</a>
                    {% endif %}

                    {% if app.user and app.user.id == commentaire.UserId.id or is_granted('ROLE_ADMIN') %}
                    <form action="{{ path('commentaire_delete', {'recipe' : recipe.id ,'id': commentaire.id}) }}" method="post" style="display: inline;">

                        <input type="hidden" name="_token" value="{{ csrf_token('delete') }}">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce commentaire ?');">Supprimer</button>
        
                    </form>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td>{{commentaire.content}}</td>
            </tr>
        </tbody>
    </table>
        {%endfor%}
    </div>
    <div>
         <a href="{{ path('commentaire_new',{ 'id': recipe.id}) }}">Ajouter commentaire</a>
    </div>
    <a href="{{ path('all_recipes') }}">Retour</a>

    {% if app.user and app.user.id == recipe.UserId.id %}
        
    <form action="{{ path('recipe_delete',{ 'id': recipe.id}) }}" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_rec') }}">
        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette recette ?');">Supprimer la recette</button>
    </form>

    {% endif %}

{% endblock %}