{% extends 'base.html.twig' %}

{% block title %}Hello RecipesController!{% endblock %}

{% block body %}

<h1>Liste des recettes</h1>

<div>
    {% for categorie in categories %}
    <form action="{{ path('category_show', {'id': categorie.id}) }}" method="post"> 
        <button type="submit" value="{{categorie.id}}"class="btn border">{{categorie.name}}</button>
    </form>
    {% endfor %}
</div>

<div>
    <ul>
        {% for recipe in recipes %}
        <li>
            <a href="{{ path('recipe_show', {'id': recipe.id}) }}">{{recipe.title}}</a>
        </li>
        {% endfor %}
    </ul>
</div>
{% endblock %}